print("🤖 Chatbot: Hello! I'm your Python chatbot.")
print("🤖 Chatbot: Type 'bye' anytime to end the conversation.\n")

while True:
    user = input("You: ").lower().strip()

    # Greetings
    if user in ["hi", "hello", "hey", "hii"]:
        print("🤖 Chatbot: Hello! Nice to meet you.")
    
    elif "good morning" in user:
        print("🤖 Chatbot: Good morning! Have a wonderful day.")
    
    elif "good afternoon" in user:
        print("🤖 Chatbot: Good afternoon! How is your day going?")
    
    elif "good evening" in user:
        print("🤖 Chatbot: Good evening! I hope you're doing well.")

    # Introduction
    elif "your name" in user or "who are you" in user:
        print("🤖 Chatbot: My name is PyBot. I'm a simple chatbot made using Python.")

    elif "who made you" in user:
        print("🤖 Chatbot: I was created using a Python program.")

    # Feelings
    elif "how are you" in user:
        print("🤖 Chatbot: I'm doing great! Thanks for asking. How are you?")

    elif "i am fine" in user or "i am good" in user:
        print("🤖 Chatbot: That's great to hear! 😊")

    elif "i am sad" in user:
        print("🤖 Chatbot: I'm sorry to hear that. I hope things get better soon.")

    elif "i am happy" in user:
        print("🤖 Chatbot: That's wonderful! Keep smiling! 😄")

    # General questions
    elif "what can you do" in user:
        print("🤖 Chatbot: I can have simple conversations, answer basic questions, and tell jokes.")

    elif "what is python" in user:
        print("🤖 Chatbot: Python is a popular programming language known for its simplicity.")

    elif "do you like python" in user:
        print("🤖 Chatbot: Yes! Python is one of my favorite programming languages. 🐍")

    # Time and study
    elif "what should i study" in user:
        print("🤖 Chatbot: You can study Python, mathematics, science, or any subject you enjoy.")

    elif "i am bored" in user:
        print("🤖 Chatbot: Try learning something new, watching a movie, or solving a programming problem!")

    # Jokes
    elif "tell me a joke" in user or "joke" in user:
        print("🤖 Chatbot: Why do programmers prefer dark mode?")
        print("🤖 Chatbot: Because light attracts bugs! 😂")

    elif "another joke" in user:
        print("🤖 Chatbot: Why did the computer go to the doctor?")
        print("🤖 Chatbot: Because it had a virus! 😄")

    # Thanks
    elif "thank you" in user or "thanks" in user:
        print("🤖 Chatbot: You're welcome! 😊")

    # Goodbye
    elif user in ["bye", "goodbye", "exit", "quit"]:
        print("🤖 Chatbot: Goodbye! Have a great day! 👋")
        break

    # Unknown input
    else:
        print("🤖 Chatbot: That's interesting! Tell me more.")